/* macos-keyflow.rc */
#include <windows.h>

/* App icon (ID 1 = IDI_APP in macos-keyflow.c) */
1 ICON "macos-keyflow.ico"

/* UAC manifest */
1 RT_MANIFEST "macos-keyflow.manifest"

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MacKeyFlow - macOS-style keyboard shortcuts for Windows\0"
            VALUE "FileVersion", "1.1.0\0"
            VALUE "InternalName", "macos-keyflow\0"
            VALUE "OriginalFilename", "macos-keyflow.exe\0"
            VALUE "ProductName", "MacKeyFlow\0"
            VALUE "ProductVersion", "1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
